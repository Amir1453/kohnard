use crate::Symbol;
use crate::frontend::ast;
use crate::frontend::tokens::{Token, LexicalError};
use crate::frontend::parser::ParseCtxt;
use crate::types::Ty;
use crate::types::TyKind;

use thin_vec::{thin_vec, ThinVec};

grammar(ctx: &ParseCtxt);

// ...

extern {
  type Location = usize;
  type Error = LexicalError;

  enum Token {
    "DEF" => Token::KeywordDef,
    "AUTO" => Token::KeywordAuto,
    "FN" => Token::KeywordFn,
    "VAR" => Token::KeywordVar,
    "LET" => Token::KeywordLet,
    "MUT" => Token::KeywordMut,
    "INT" => Token::KeywordInt,
    "BOOL" => Token::KeywordBool,
    "VOID" => Token::KeywordVoid,
    "RETURN" => Token::KeywordReturn,
    "IF" => Token::KeywordIf,
    "ELSE" => Token::KeywordElse,
    "WHILE" => Token::KeywordWhile,
    "BREAK" => Token::KeywordBreak,
    "CONTINUE" => Token::KeywordContinue,
    "TRUE" => Token::KeywordTrue,
    "FALSE" => Token::KeywordFalse,
    "IDENT" => Token::Identifier(<Symbol>),
    "NUMBER" => Token::Number(<i64>),
    "," => Token::Comma,
    "(" => Token::LParen,
    ")" => Token::RParen,
    "{" => Token::LCurlyParen,
    "}" => Token::RCurlyParen,
    "=" => Token::Assign,
    ";" => Token::Semicolon,
    ":" => Token::Colon,
    "->" => Token::Arrow,
    "+" => Token::OpPlus,
    "-" => Token::OpMinus,
    "*" => Token::OpStar,
    "/" => Token::OpSlash,
    "%" => Token::OpMod,
    "|" => Token::OpPipe,
    "^" => Token::OpCaret,
    "&" => Token::OpAmpersand,
    "~" => Token::OpTilde,
    "<<" => Token::OpLShift,
    ">>" => Token::OpRShift,
    "==" => Token::OpEq,
    "!=" => Token::OpNEq,
    "<" => Token::OpL,
    "<=" => Token::OpLTE,
    ">" => Token::OpG,
    ">=" => Token::OpGTE,
    "&&" => Token::OpLAnd,
    "||" => Token::OpLOr,
    "!" => Token::OpLNot,
  }
}

// This is the * equivalent for ThinVec.
Star<T>: ThinVec<T> = {
    => ThinVec::new(),
    <items:Plus<T>> => items,
};

// This is the + equivalent for ThinVec.
Plus<T>: ThinVec<T> = {
    <item:T> => thin_vec![item],

    <mut items:Plus<T>> <item:T> => {
        items.push(item);
        items
    },
};

pub BX: ast::Program = {
  <decls:Declaration*> => ast::Program(decls)
}

Declaration: ast::Declaration = {
  <var_decl:VarDecl> => ast::Declaration::Variable(Box::new(var_decl)),

  <proc_decl:ProcDecl> => proc_decl,
}

VarDecl: ast::Variable = {
  <start:@L> "VAR" <name:"IDENT"> "=" <value:Expression> <name_value_pair:Star<("," <"IDENT"> "=" <Expression>)>> ":" <ty:Type> ";" <end:@R> => {
    let (mut names, mut values): (ThinVec<Symbol>, ThinVec<Box<ast::Expression>>) = name_value_pair.into_iter().unzip();
    names.insert(0, name);
    values.insert(0, value);
    ast::Variable {names, values, ty, span: ctx.span(start, end)}
  }
}

ProcDecl: ast::Declaration = {
  BXProcDecl,
  RustProcDecl,
  CProcDecl,
}

BXProcDecl: ast::Declaration = {
  <start:@L> "DEF" <proc_name:"IDENT"> "(" <proc_args:ProcArgs?> ")" <return_type:(":" <Type>)?> <block:Block> <end:@R> =>
    ctx.proc_decl(proc_name, proc_args, return_type, block, ctx.span(start, end)),
}

RustProcDecl: ast::Declaration = {
  <start:@L> "FN" <proc_name:"IDENT"> "(" <proc_args:ProcArgs?> ")" <return_type:("->" <Type>)?> <block:Block> <end:@R> =>
    ctx.proc_decl(proc_name, proc_args, return_type, block, ctx.span(start, end)),
}

CProcDecl: ast::Declaration = {
  <start:@L> <rty:Type> <proc_name:"IDENT"> "(" <proc_args:ProcArgs?> ")" <block:Block> <end:@R> =>
    ctx.proc_decl(proc_name, proc_args, Some(rty), block, ctx.span(start, end)),

  <start:@L> "AUTO" <proc_name:"IDENT"> "(" <proc_args:ProcArgs?> ")" <return_type:("->" <Type>)?> <block:Block> <end:@R> =>
    ctx.proc_decl(proc_name, proc_args, return_type, block, ctx.span(start, end)),
}

ProcArgs: ThinVec<(Symbol, Ty)> = {
  <arg:"IDENT"> ":" <ty:Type> <mut arg_type_pair:Star<("," <"IDENT"> ":" <Type>)>> => {
    arg_type_pair.insert(0, (arg, ty));
    arg_type_pair
  }
}

Type: Ty = {
  "INT" => Ty::INT,
  "BOOL" => Ty::BOOL, 
  "VOID" => Ty::VOID,

  "&" <ty:Type> => Ty::intern(TyKind::Ref(ty)),
  "&" "MUT" <ty:Type> => Ty::intern(TyKind::MutRef(ty)),

  "*" <ty:Type> => Ty::intern(TyKind::Ptr(ty)),
  "*" "MUT" <ty:Type> => Ty::intern(TyKind::MutPtr(ty)),
}

Block: Box<ast::Block> = {
  <start:@L> "{" <statements:Star<Statement>> "}" <end:@R> => {
    Box::new(ast::Block { statements, span: ctx.span(start, end) })
  },
}

Statement: ast::Statement = {
  <start:@L> <kind:StatementKind> <end:@R> => ctx.statement(kind, ctx.span(start, end)),
}

StatementKind: ast::StatementKind = {
  <var_decl:VarDecl> => ast::StatementKind::Variable(Box::new(var_decl)),

  <name:"IDENT"> "=" <value:Expression> ";" => {
    ast::StatementKind::Assignment { name, value }
  },

  <expr:Expression> ";" => ast::StatementKind::Eval(expr),

  "RETURN" <expr:Expression?> ";" => ast::StatementKind::Return(expr),

  <block:Block> => ast::StatementKind::Block(block),

  <ifelse:IFElse> => ifelse,

  "WHILE" "(" <condition:Expression> ")" <block:Block> => {
    ast::StatementKind::While { condition, block }
  },

  "BREAK" ";"=> ast::StatementKind::Jump(ast::JumpState::Break),

  "CONTINUE" ";" => ast::StatementKind::Jump(ast::JumpState::Continue),
}

IFElse: ast::StatementKind = {
  "IF" "(" <condition:Expression> ")" <then_block:Block> <ifrest:IFRest> => {
    ast::StatementKind::If {
      condition,
      then_block,
      else_branch: ifrest,
    }
  },
}

IFRest: Option<Box<ast::Statement>> = {
    "ELSE" <block:Block> => {
        let span = block.span;
        Some(Box::new(ctx.statement(ast::StatementKind::Block(block), span)))
    },

    "ELSE" <start:@L> <kind:IFElse> <end:@R> => {
        Some(Box::new(ctx.statement(kind, ctx.span(start, end))))
    },

    => None,
};

Expression: Box<ast::Expression> = {
  #[precedence(level="1")]
  Term,
  ProcCall,

  #[precedence(level="10")] #[assoc(side="right")]
  <start:@L> "~" <value:Expression> <end:@R> =>
    ctx.unary(ast::Operator::Tilde, value, ctx.span(start, end)),

  #[precedence(level="20")] #[assoc(side="right")]
  <start:@L> "-" <value:Expression> <end:@R> =>
    ctx.unary(ast::Operator::Neg, value, ctx.span(start, end)),

  <start:@L> "!" <value:Expression> <end:@R> =>
    ctx.unary(ast::Operator::LNot, value, ctx.span(start, end)),

  <start:@L> "&" <value:Expression> <end:@R> =>
    ctx.unary(ast::Operator::Ref, value, ctx.span(start, end)),

  <start:@L> "&" "MUT" <value:Expression> <end:@R> =>
    ctx.unary(ast::Operator::MutRef, value, ctx.span(start, end)),

  <start:@L> "*" <value:Expression> <end:@R> =>
    ctx.unary(ast::Operator::Deref, value, ctx.span(start, end)),

  #[precedence(level="30")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "*" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Star, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> "/" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Slash, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> "%" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Mod, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="40")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "+" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Plus, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> "-" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Minus, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="50")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "<<" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::LShift, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> ">>" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::RShift, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="53")] #[assoc(side="none")]
  <start:@L> <lhs:Expression> "<" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::L, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> "<=" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::LTE, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> ">" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::G, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> ">=" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::GTE, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="56")] #[assoc(side="none")]
  <start:@L> <lhs:Expression> "==" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Equal, lhs, rhs, ctx.span(start, end)),

  <start:@L> <lhs:Expression> "!=" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::NEqual, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="60")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "&" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Ampersand, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="70")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "^" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Caret, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="80")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "|" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::Pipe, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="83")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "&&" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::LAnd, lhs, rhs, ctx.span(start, end)),

  #[precedence(level="86")] #[assoc(side="left")]
  <start:@L> <lhs:Expression> "||" <rhs:Expression> <end:@R> =>
    ctx.binary(ast::Operator::LOr, lhs, rhs, ctx.span(start, end)),
}

Term: Box<ast::Expression> = {
  <start:@L> <val:"NUMBER"> <end:@R> => {
    ctx.expr(ast::ExpressionKind::Number(val), ctx.span(start, end))
  },

  <start:@L> <name:"IDENT"> <end:@R> => {
    ctx.expr(ast::ExpressionKind::Variable(name, None), ctx.span(start, end))
  },

  <start:@L> "TRUE" <end:@R> => {
    ctx.expr(ast::ExpressionKind::Bool(true), ctx.span(start, end))
  },

  <start:@L> "FALSE" <end:@R> => {
    ctx.expr(ast::ExpressionKind::Bool(false), ctx.span(start, end))
  },

  <start:@L> "(" <mut expr:Expression> ")" <end:@R> => {
    expr.span = ctx.span(start, end);
    expr
  },
}

ProcCall: Box<ast::Expression> = {
  <start:@L> <proc_name:"IDENT"> "(" <proc_args:ProcCallArgs?> ")" <end:@R> => ctx.expr(
    ast::ExpressionKind::ProcCall {
      proc_name,
      proc_args, 
      ty: None
    }, ctx.span(start, end)),
}

ProcCallArgs: ThinVec<Box<ast::Expression>> = {
  <arg:Expression> <mut args:Star<("," <Expression>)>> => {
    args.insert(0, arg);
    args
  }
}
